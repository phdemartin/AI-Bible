#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "app_icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,2,0
PRODUCTVERSION  1,1,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Logos & Lumiere\0"
            VALUE "FileDescription",  "AI Bible — Logos & Lumiere (Bible Study Studio)\0"
            VALUE "FileVersion",      "1.1.2.0\0"
            VALUE "InternalName",     "AI_Bible\0"
            VALUE "LegalCopyright",   "Open Source GPLv3 — Logos & Lumiere\0"
            VALUE "OriginalFilename", "AI_Bible.exe\0"
            VALUE "ProductName",      "AI Bible — Logos & Lumiere\0"
            VALUE "ProductVersion",   "1.1.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
